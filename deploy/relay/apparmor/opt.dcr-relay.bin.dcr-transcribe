# AppArmor: 中継サーバ本体。/etc/apparmor.d/opt.dcr-relay.bin.dcr-transcribe
# 読み込み:   sudo apparmor_parser -r -W /etc/apparmor.d/opt.dcr-relay.bin.dcr-transcribe
# 最初は complain で動かし、journalctl -k -g apparmor で拒否されたものを確かめてから enforce にする:
#   sudo aa-complain /etc/apparmor.d/opt.dcr-relay.bin.dcr-transcribe
#   sudo aa-enforce  /etc/apparmor.d/opt.dcr-relay.bin.dcr-transcribe

abi <abi/4.0>,
include <tunables/global>

profile dcr-relay /opt/dcr-relay/bin/dcr-transcribe flags=(enforce) {
  include <abstractions/base>
  # 名前解決(/etc/resolv.conf, nsswitch, systemd-resolved)
  include <abstractions/nameservice>
  # Turnstile の検証(HTTPS)で証明書を読む
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  deny network raw,
  deny network packet,
  deny network netlink,

  signal (receive) set=(term, int, kill, hup) peer=unconfined,

  /opt/dcr-relay/bin/dcr-transcribe mr,

  # 設定・証明書(読むだけ)。秘密鍵は systemd の資格情報から
  /etc/dcr-relay/ r,
  /etc/dcr-relay/** r,
  deny /etc/dcr-relay/tls/*.key r,
  /run/credentials/dcr-relay.service/ r,
  /run/credentials/dcr-relay.service/* r,

  # 状態: ログインキー・トークン(初回に生成)と、受け取った区間録音
  /var/lib/dcr-relay/ rw,
  /var/lib/dcr-relay/** rwk,

  # Rust の標準ライブラリ・tokio が CPU 数を調べる
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/stat r,
  @{sys}/fs/cgroup/** r,
  @{sys}/devices/system/cpu/online r,
  @{sys}/devices/system/cpu/possible r,

  # ほかは読ませない・書かせない
  deny @{HOME}/** rwklx,
  deny /root/** rwklx,
  deny /etc/cloudflared/** rwklx,
  deny /etc/shadow r,
  deny /etc/ssh/** r,
  deny /boot/** r,
  deny /** x,
}

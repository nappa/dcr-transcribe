# AppArmor: cloudflared。/etc/apparmor.d/usr.bin.cloudflared
# Go で書かれており、何を読むかは版によって変わるので、必ず complain で数日動かして確かめてから enforce にする

abi <abi/4.0>,
include <tunables/global>

profile cloudflared /usr/bin/cloudflared flags=(enforce) {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network netlink raw,
  deny network packet,

  signal (receive) set=(term, int, kill, hup) peer=unconfined,

  /usr/bin/cloudflared mr,

  # systemd の資格情報(トークン)
  /run/credentials/cloudflared.service/ r,
  /run/credentials/cloudflared.service/* r,
  /etc/cloudflared/ r,

  # Go のランタイムが読むもの
  @{PROC}/sys/net/core/somaxconn r,
  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  @{PROC}/@{pid}/maps r,
  @{PROC}/@{pid}/stat r,
  @{sys}/fs/cgroup/** r,
  @{sys}/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  @{sys}/devices/system/cpu/online r,

  deny @{HOME}/** rwklx,
  deny /root/** rwklx,
  deny /etc/dcr-relay/** rwklx,
  deny /var/lib/dcr-relay/** rwklx,
  deny /etc/shadow r,
  deny /etc/ssh/** r,
  deny /** x,
}

# dcr-transcribe Configuration Example
# Copy this file to config.toml and modify as needed

[audio]
# Audio device ID (use --show-interfaces to list available devices)
device_id = "default"
# Sample rate in Hz (8000, 16000, 44100, 48000)
sample_rate = 48000
# Number of input channels (2 for stereo)
channels = 2
# Output device ID for audio playback
output_device_id = "default"

[vad]
# Voice Activity Detection threshold in dB
threshold_db = -40.0
# Hangover duration in milliseconds (how long to keep detecting voice after it stops)
hangover_duration_ms = 500
# Silence duration threshold in milliseconds (disconnect after this much silence)
silence_disconnect_threshold_ms = 3000

[buffer]
# Buffer capacity in seconds
capacity_seconds = 10
# Drop policy when buffer is full: "drop_oldest", "drop_newest", or "block"
drop_policy = "drop_oldest"

[transcribe]
# Backend type: "aws" or "whisper"
backend = "aws"
# AWS region (only for AWS backend)
region = "ap-northeast-1"
# Language code: "ja-JP", "en-US", etc.
language_code = "ja-JP"
# Sample rate for transcription (should match audio.sample_rate)
sample_rate = 48000
# Connect to transcription service on startup (false = wait for voice detection)
connect_on_startup = false
# Send buffered audio on reconnection
send_buffered_on_reconnect = true

# AWS 認証(未指定なら従来の環境変数・~/.aws 設定を使用)
# プロファイルを選ぶ場合。aws login 利用時は期限切れ時に再認証が必要。
# [transcribe.aws]
# profile = "default"
# またはアクセスキーを直接指定(profile と併用不可)
# [transcribe.aws]
# access_key_id = ""
# secret_access_key = ""
# session_token = "" # 一時認証情報の場合だけ必要

# Whisper API configuration (only needed if backend = "whisper")
# [whisper]
# api_key = "YOUR_OPENAI_API_KEY_HERE"
# model = "whisper-1"
# language = "ja"
# chunk_duration_secs = 5

[output]
# Directory for WAV file output
wav_output_dir = "./recordings"

# Remote viewer (HTTP/SSE server, expose via Cloudflare Tunnel)
# Tail-style live view of confirmed transcripts in any browser.
# Use a named tunnel with `cloudflared` (see README). Quick Tunnels do not support SSE.
# [remote]
# enabled = true
# listen = "127.0.0.1:8765"     # bind address (keep on loopback; cloudflared reaches localhost)
# history_size = 200            # entries kept for new clients on reconnect
# include_partials = false      # also stream partial results (more bandwidth)
# partial_throttle_ms = 500     # throttle partials per channel (only used if include_partials=true)
# login_key_file = "./secrets/login_key"  # open /?k=<key> to log in (cookie); generated on first start if missing
# public_url = "https://transcribe.example.com"  # shown as URL / QR in the TUI (`u`); derived from the tunnel config if empty
# login_key = ""                # or set the key directly (takes precedence over the file)
# allowed_countries = ["JP"]    # allow only these countries (Cloudflare CF-IPCountry); empty = no restriction
# turnstile_site_key = ""       # Cloudflare Turnstile site key; set both keys to require a bot check
# turnstile_secret_key = ""     # Cloudflare Turnstile secret key
# session_hours = 12            # how long a passed bot check stays valid
# block_tor = true              # reject Tor (Cloudflare CF-IPCountry: T1), even when allowed_countries is empty
# access_log = true             # one JSON line per request (log target "access"; login keys are masked)
# block_private_relay = false   # reject iCloud Private Relay (Apple's egress list vs CF-Connecting-IP, refreshed daily)
# private_relay_cache = "./private-relay-egress.csv"
# require_fetch_metadata = true # refuse requests without Sec-Fetch-* (unsupported browsers); false only for debugging with curl
# [remote.browser]              # minimum browser versions (older ones get "not supported")
# min_chromium = 120
# min_safari = "16.4"           # also used for every browser on iPhone / iPad (WebKit)
# min_firefox = 128

# Per-utterance recording (split on silence), playable from the remote viewer
# [segments]
# enabled = true
# dir = "./recordings/segments"  # a timestamped subdirectory is created per run
# format = "aac"                 # "aac" (ADTS, small, streaming-friendly) or "wav"
# profile = "he"                 # "he" (HE-AAC, for 16-32 kbps) or "lc" (AAC-LC, 48 kbps+)
# bitrate = 24000                # AAC bitrate (bps)
# silence_split_ms = 2000        # close a segment after this much silence
# pre_roll_ms = 300              # audio kept before the voice onset
# tail_ms = 300                  # silence kept after the last voice
# min_voice_ms = 300             # discard segments with less voice than this (noise)
# max_duration_secs = 300        # split segments longer than this

# Run cloudflared as a child process (started/restarted/stopped with the app)
# [tunnel]
# enabled = true
# token = "eyJ..."                              # dashboard-managed tunnel token (Zero Trust → Networks → Tunnels), or:
# token_file = ""                               # file containing the token, or:
# config = "~/.cloudflared/dcr-transcribe.yml"  # locally-managed tunnel config
# cloudflared = "cloudflared"                   # executable name (searched in PATH and bin_dir) or path
# auto_download = true                          # download the official release if cloudflared is missing
# bin_dir = "./bin"                             # where the downloaded cloudflared is placed

# Live listening from the remote viewer: pick channels, the server mixes them and streams AAC
# [live]
# enabled = true
# profile = "he"                 # "he" (HE-AAC) or "lc"
# bitrate = 16000                # AAC bitrate (bps) per listened mix (~2 KB/s)

# Send everything to a relay server (dcr-transcribe --relay on a VPS) over one QUIC (UDP) connection with mutual TLS.
# Not via cloudflared. Viewers connect to the relay, so the venue uplink carries one copy regardless of the number of viewers.
# Create the certificates with: dcr-transcribe --gen-uplink-pki ./secrets/uplink <relay IP or name>
# Can be used together with [remote] (local viewer server).
# [uplink]
# enabled = true
# server = "203.0.113.5:443"     # relay address (IP:port or name:port, UDP)
# server_name = ""               # name/IP to match the relay certificate's SAN; host part of `server` if empty
# ca_file = "./secrets/uplink/ca.pem"
# cert_file = "./secrets/uplink/venue.pem"
# key_file = "./secrets/uplink/venue.key"
# public_url = "https://relay.example.com"  # viewer URL (via cloudflared), shown in the TUI (`u`)
# live = true                    # send live audio (only channels someone is listening to on the relay)
# live_bitrate = 16000           # Opus bitrate per channel (bps)
# include_partials = false       # also send partial results (more bandwidth)
# retain_events = 5000           # transcripts kept for resending after the relay restarts

# Clock drift monitoring (SNTP; only measures, never adjusts the clock)
# [clock]
# enabled = true
# server = "time.cloudflare.com"
# interval_secs = 64
# warn_ms = 500                  # log a warning (and show yellow) beyond this drift

# Channel configuration
[[channels]]
id = 0
name = "Channel 1"
enabled = true

[[channels]]
id = 1
name = "Channel 2"
enabled = true
